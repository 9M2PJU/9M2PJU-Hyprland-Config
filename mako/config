# Mako Notification Daemon Configuration
# ThinkPad T460 / Hyprland

font=Noto Sans 10
width=360
height=120
margin=12
padding=12
border-size=2
border-radius=8
icons=1
max-icon-size=48
layer=overlay
anchor=top-right

# Colors (Dark Modern Theme)
background-color=#1e1e2ecc
text-color=#cdd6f4ff
border-color=#585b70ff
progress-color=over #89b4faff

# Timeouts in milliseconds (3000ms = 3s)
default-timeout=3000
ignore-timeout=0
max-visible=5

[urgency=low]
border-color=#313244ff
default-timeout=2000

[urgency=normal]
border-color=#89b4faff
default-timeout=3000

[urgency=high]
border-color=#f38ba8ff
text-color=#f38ba8ff
default-timeout=5000
